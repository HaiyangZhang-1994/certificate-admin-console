{
  "name": "certificate-admin-console",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "packages/api-contract"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/python.mjs -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload --reload-dir backend/app",
    "dev:frontend": "npm run dev --workspace @certificate-admin/frontend",
    "build": "npm run build --workspace @certificate-admin/frontend",
    "typecheck": "npm run typecheck --workspace @certificate-admin/frontend",
    "test:backend": "node scripts/python.mjs -m pytest -c backend/pyproject.toml backend/tests",
    "lint:backend": "node scripts/python.mjs -m ruff check backend",
    "contract:export": "node scripts/python.mjs backend/scripts/export_openapi.py",
    "contract:types": "openapi-typescript docs/api/openapi.json -o packages/api-contract/src/schema.d.ts",
    "contract:generate": "npm run contract:export && npm run contract:types",
    "contract:check": "node scripts/check-contract.mjs",
    "check": "npm run contract:check && npm run lint:backend && npm run test:backend && npm run build"
  },
  "devDependencies": {
    "openapi-typescript": "^7.0.0"
  }
}
