{
  "components": {
    "schemas": {
      "AdminSummary": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "name"
        ],
        "title": "AdminSummary",
        "type": "object"
      },
      "BulkIssueResult": {
        "additionalProperties": false,
        "properties": {
          "failed_count": {
            "minimum": 0.0,
            "title": "Failed Count",
            "type": "integer"
          },
          "issued_count": {
            "minimum": 0.0,
            "title": "Issued Count",
            "type": "integer"
          },
          "results": {
            "items": {
              "discriminator": {
                "mapping": {
                  "failed": "#/components/schemas/FailedOutcome",
                  "issued": "#/components/schemas/IssuedOutcome",
                  "skipped": "#/components/schemas/SkippedOutcome"
                },
                "propertyName": "outcome"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/IssuedOutcome"
                },
                {
                  "$ref": "#/components/schemas/SkippedOutcome"
                },
                {
                  "$ref": "#/components/schemas/FailedOutcome"
                }
              ]
            },
            "title": "Results",
            "type": "array"
          },
          "skipped_count": {
            "minimum": 0.0,
            "title": "Skipped Count",
            "type": "integer"
          }
        },
        "required": [
          "issued_count",
          "skipped_count",
          "failed_count",
          "results"
        ],
        "title": "BulkIssueResult",
        "type": "object"
      },
      "CertificateDetail": {
        "additionalProperties": false,
        "properties": {
          "course": {
            "$ref": "#/components/schemas/CourseRef"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "issued_at": {
            "format": "date-time",
            "title": "Issued At",
            "type": "string"
          },
          "issued_by": {
            "$ref": "#/components/schemas/AdminSummary"
          },
          "learner": {
            "$ref": "#/components/schemas/LearnerSummary"
          },
          "revoked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          },
          "revoked_by": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AdminSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "serial_number": {
            "title": "Serial Number",
            "type": "string"
          },
          "status": {
            "enum": [
              "valid",
              "revoked"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "learner",
          "course",
          "serial_number",
          "issued_at",
          "status",
          "issued_by",
          "revoked_at",
          "revoked_by"
        ],
        "title": "CertificateDetail",
        "type": "object"
      },
      "CertificatePage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CertificateSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "CertificatePage",
        "type": "object"
      },
      "CertificateSummary": {
        "additionalProperties": false,
        "properties": {
          "course": {
            "$ref": "#/components/schemas/CourseRef"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "issued_at": {
            "format": "date-time",
            "title": "Issued At",
            "type": "string"
          },
          "learner": {
            "$ref": "#/components/schemas/LearnerSummary"
          },
          "serial_number": {
            "title": "Serial Number",
            "type": "string"
          },
          "status": {
            "enum": [
              "valid",
              "revoked"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "learner",
          "course",
          "serial_number",
          "issued_at",
          "status"
        ],
        "title": "CertificateSummary",
        "type": "object"
      },
      "CourseList": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CourseSummary"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "CourseList",
        "type": "object"
      },
      "CourseRef": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "title": "CourseRef",
        "type": "object"
      },
      "CourseSummary": {
        "additionalProperties": false,
        "properties": {
          "already_issued_count": {
            "minimum": 0.0,
            "title": "Already Issued Count",
            "type": "integer"
          },
          "completed_count": {
            "minimum": 0.0,
            "title": "Completed Count",
            "type": "integer"
          },
          "eligible_count": {
            "minimum": 0.0,
            "title": "Eligible Count",
            "type": "integer"
          },
          "ends_at": {
            "format": "date-time",
            "title": "Ends At",
            "type": "string"
          },
          "enrollment_count": {
            "minimum": 0.0,
            "title": "Enrollment Count",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_finished": {
            "title": "Is Finished",
            "type": "boolean"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "ends_at",
          "is_finished",
          "enrollment_count",
          "completed_count",
          "eligible_count",
          "already_issued_count"
        ],
        "title": "CourseSummary",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "unauthorized",
          "invalid_credentials",
          "forbidden_origin",
          "resource_not_found",
          "validation_error",
          "course_not_finished",
          "idempotency_conflict",
          "database_busy",
          "internal_error",
          "not_implemented"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FailedOutcome": {
        "additionalProperties": false,
        "properties": {
          "certificate_id": {
            "title": "Certificate Id",
            "type": "null"
          },
          "enrollment_id": {
            "format": "uuid",
            "title": "Enrollment Id",
            "type": "string"
          },
          "learner_id": {
            "format": "uuid",
            "title": "Learner Id",
            "type": "string"
          },
          "learner_name": {
            "title": "Learner Name",
            "type": "string"
          },
          "outcome": {
            "const": "failed",
            "title": "Outcome",
            "type": "string"
          },
          "reason": {
            "const": "invalid_enrollment",
            "title": "Reason",
            "type": "string"
          },
          "serial_number": {
            "title": "Serial Number",
            "type": "null"
          }
        },
        "required": [
          "enrollment_id",
          "learner_id",
          "learner_name",
          "outcome",
          "reason",
          "certificate_id",
          "serial_number"
        ],
        "title": "FailedOutcome",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "const": "certificate-admin-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Identity": {
        "additionalProperties": false,
        "properties": {
          "admin": {
            "$ref": "#/components/schemas/AdminSummary"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantSummary"
          }
        },
        "required": [
          "admin",
          "tenant"
        ],
        "title": "Identity",
        "type": "object"
      },
      "IssuedOutcome": {
        "additionalProperties": false,
        "properties": {
          "certificate_id": {
            "format": "uuid",
            "title": "Certificate Id",
            "type": "string"
          },
          "enrollment_id": {
            "format": "uuid",
            "title": "Enrollment Id",
            "type": "string"
          },
          "learner_id": {
            "format": "uuid",
            "title": "Learner Id",
            "type": "string"
          },
          "learner_name": {
            "title": "Learner Name",
            "type": "string"
          },
          "outcome": {
            "const": "issued",
            "title": "Outcome",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "null"
          },
          "serial_number": {
            "title": "Serial Number",
            "type": "string"
          }
        },
        "required": [
          "enrollment_id",
          "learner_id",
          "learner_name",
          "outcome",
          "reason",
          "certificate_id",
          "serial_number"
        ],
        "title": "IssuedOutcome",
        "type": "object"
      },
      "LearnerSummary": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ],
        "title": "LearnerSummary",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "SkippedOutcome": {
        "additionalProperties": false,
        "properties": {
          "certificate_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Certificate Id"
          },
          "enrollment_id": {
            "format": "uuid",
            "title": "Enrollment Id",
            "type": "string"
          },
          "learner_id": {
            "format": "uuid",
            "title": "Learner Id",
            "type": "string"
          },
          "learner_name": {
            "title": "Learner Name",
            "type": "string"
          },
          "outcome": {
            "const": "skipped",
            "title": "Outcome",
            "type": "string"
          },
          "reason": {
            "enum": [
              "not_completed",
              "already_issued",
              "certificate_revoked"
            ],
            "title": "Reason",
            "type": "string"
          },
          "serial_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serial Number"
          }
        },
        "required": [
          "enrollment_id",
          "learner_id",
          "learner_name",
          "outcome",
          "reason",
          "certificate_id",
          "serial_number"
        ],
        "title": "SkippedOutcome",
        "type": "object"
      },
      "TenantSummary": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "timezone": {
            "examples": [
              "Australia/Sydney"
            ],
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "timezone"
        ],
        "title": "TenantSummary",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyCookie": {
        "in": "cookie",
        "name": "certificate_admin_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Tenant-isolated certificate administration API.",
    "title": "Certificate Admin API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Implemented"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Implemented"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/certificates": {
      "get": {
        "operationId": "listCertificates",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 200,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "course_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Course Id"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "valid",
                    "revoked"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "sort_by",
            "required": false,
            "schema": {
              "default": "issued_at",
              "enum": [
                "issued_at",
                "learner_name",
                "serial_number"
              ],
              "title": "Sort By",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort_order",
            "required": false,
            "schema": {
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ],
              "title": "Sort Order",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificatePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Implemented"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "List Certificates",
        "tags": [
          "certificates"
        ]
      }
    },
    "/api/certificates/export.csv": {
      "get": {
        "operationId": "exportCertificates",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 200,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
